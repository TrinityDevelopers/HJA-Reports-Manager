{
  "name": "hja-reports-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "HJA Reports Manager - Full Stack Application with Frontend and Backend",
  "scripts": {
    "postinstall": "npm run shared:install && npm run backend:install && npm run frontend:install",
    "dev": "npm run frontend:dev",
    "dev:backend": "npm run backend:dev",
    "dev:both": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:shared": "cd packages/shared && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "preview": "cd frontend && npm run preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"frontend/src/**/*.{js,jsx,ts,tsx,json,css,md,mdx}\" \"frontend/public/**/*.{js,jsx,ts,tsx,json,css,md,mdx}\" \"backend/src/**/*.{js,jsx,ts,tsx,json,md}\" \"backend/tests/**/*.{js,jsx,ts,tsx,json,md}\" \"packages/shared/src/**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"frontend/src/**/*.{js,jsx,ts,tsx,json,css,md,mdx}\" \"frontend/public/**/*.{js,jsx,ts,tsx,json,css,md,mdx}\" \"backend/src/**/*.{js,jsx,ts,tsx,json,md}\" \"backend/tests/**/*.{js,jsx,ts,tsx,json,md}\" \"packages/shared/src/**/*.{ts,json,md}\"",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm run test",
    "test:frontend": "cd frontend && npm run test",
    "validate:templates": "cd backend && npm run validate:templates",
    "test:ui": "cd backend && npm run test:ui",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:install": "cd frontend && npm install",
    "backend:dev": "cd backend && npm run dev",
    "backend:install": "cd backend && npm install",
    "shared:install": "cd packages/shared && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
