# Copy to .env in the repo root for docker compose:
#   cp .env.docker.example .env

DB_PASSWORD=hja_dev_password
DB_DATABASE=hja_reports

# URL opened in the browser for the frontend container
CORS_ORIGIN=http://localhost:8080

# API URL baked into the frontend build (must match how you reach the backend)
VITE_API_URL=http://localhost:5000/api

BACKEND_PORT=5000
FRONTEND_PORT=8080
