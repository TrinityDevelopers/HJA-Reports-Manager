# Database type: mysql or postgres
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=yourpassword
DB_DATABASE=hja_reports

# Create/update tables from entities on startup (default: enabled)
# DB_SYNCHRONIZE=false

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Optional: prefer Cloudmersive for XLSX→PDF; falls back to LibreOffice if unset or API fails
CLOUDMERSIVE_API_KEY=

# LibreOffice pool for PDF conversion (merged and single exports)
LIBREOFFICE_CONCURRENCY=3
# LIBREOFFICE_PATH=
