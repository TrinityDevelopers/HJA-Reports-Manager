{
  "name": "hja-reports-manager-backend",
  "version": "1.0.0",
  "description": "Backend for HJA Reports Manager with database and XLSX export",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "migration:run": "tsx src/database/runMigrations.ts",
    "migration:run:prod": "node dist/src/database/runMigrations.js",
    "migration:revert": "tsx src/database/revertMigrations.ts",
    "migration:revert:prod": "node dist/src/database/revertMigrations.js",
    "seed": "tsx src/database/seed.ts",
    "validate:templates": "tsx scripts/validateTemplates.ts",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@hja/shared": "file:../packages/shared",
    "cloudmersive-convert-api-client": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "jszip": "^3.10.1",
    "mysql2": "^3.6.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.3",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.10.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "@vitest/ui": "^4.0.18",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
